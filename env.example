# ==== required ====

# Your Nerimity bot token
GC_TOKEN=

# ==================


# ==== rate / queue ====

# Min spacing between outbound API calls, in ms. Raise if you still see rate
# limits, lower for snappier relays on a forgiving instance
GC_MIN_GAP_MS=350

# Retries before a send is dropped
GC_MAX_ATTEMPTS=5

# First backoff step, and the ceiling, in ms
GC_BASE_BACKOFF=1000
GC_MAX_BACKOFF=30000

# Max queued tasks before the oldest gets shed
GC_QUEUE_MAX=5000

# ==== persistence ====

# Where the synced-channel list is stored
# GC_DATA_FILE=src/data/synced.json

# ==== permissions ====

# Set to 1 to let any member run /setup. Default: admins only
GC_ALLOW_ANYONE=0

# ==== logging ====

# error | warn | info | debug | trace  (or pass --debug / --trace on the cli)
GC_LOG_LEVEL=info

# ==== instance overrides ====

# Point at a self-hosted instance / localhost. Leave blank for nerimity.com
# GC_API_URL=http://localhost:8080
# GC_WS_URL=http://localhost:8080
#
# GC_CDN_URL=http://localhost:9000
